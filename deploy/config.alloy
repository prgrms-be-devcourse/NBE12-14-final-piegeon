// 착착 서버의 수집기(Grafana Alloy) 설정. compose.prod.yml의 alloy 서비스가 읽는다.
// 여기서는 모으기만 한다. 저장, 화면, 알림은 Grafana Cloud에 있다.
//
// 모으는 것 세 가지:
//   1. 앱 지표    backend:9090/actuator/prometheus (JVM, HTTP 요청, DB 커넥션 풀)
//   2. 서버 지표  CPU, 메모리, 스왑, 부하
//   3. 백엔드 로그 /logs/backend.log
//
// 주소와 토큰은 환경변수로 받는다. deploy.sh가 SSM Parameter Store에서 읽어 넘긴다.

// ── 보낼 곳 ─────────────────────────────────────────────────────────────

prometheus.remote_write "cloud" {
	endpoint {
		url = sys.env("GRAFANA_PROM_URL")

		basic_auth {
			username = sys.env("GRAFANA_PROM_USER")
			password = sys.env("GRAFANA_TOKEN")
		}
	}

	// 어느 환경에서 온 값인지 구분한다. 운영은 prod, 로컬 부하 테스트는 local
	external_labels = {
		env = sys.env("MONITORING_ENV"),
	}
}

loki.write "cloud" {
	endpoint {
		url = sys.env("GRAFANA_LOKI_URL")

		basic_auth {
			username = sys.env("GRAFANA_LOKI_USER")
			password = sys.env("GRAFANA_TOKEN")
		}
	}

	external_labels = {
		env = sys.env("MONITORING_ENV"),
	}
}

// ── 1. 앱 지표 ───────────────────────────────────────────────────────────

// 같은 compose 네트워크 안이라 서비스 이름으로 닿는다. 9090은 서버 밖으로 열려 있지 않다.
// 60초 간격: 무료 플랜 한도와 수집기 메모리를 아낀다.
prometheus.scrape "backend" {
	targets = [{
		__address__ = "backend:9090",
		instance    = "backend",
	}]
	job_name        = "backend"
	metrics_path    = "/actuator/prometheus"
	scrape_interval = "60s"
	forward_to      = [prometheus.remote_write.cloud.receiver]
}

// ── 2. 서버 지표 ─────────────────────────────────────────────────────────

// 호스트 폴더를 마운트하지 않는다. 컨테이너 안의 /proc/meminfo, /proc/stat, /proc/loadavg,
// /proc/vmstat은 컨테이너가 아닌 서버 전체 값을 보여 준다.
// 디스크 남은 용량은 백엔드가 내보내는 disk_free_bytes로 본다 (같은 디스크).
// 네트워크는 컨테이너 것만 보여서 넣지 않는다. EC2 네트워크는 CloudWatch에 있다.
prometheus.exporter.unix "host" {
	set_collectors = ["cpu", "meminfo", "loadavg", "vmstat"]
}

// job 라벨은 exporter가 정한 "integrations/unix"로 붙는다
prometheus.scrape "host" {
	targets         = prometheus.exporter.unix.host.targets
	scrape_interval = "60s"
	forward_to      = [prometheus.relabel.host.receiver]
}

// instance가 컨테이너 ID로 붙으면 재배포할 때마다 새 지표로 세어진다. 고정 이름으로 바꾼다.
prometheus.relabel "host" {
	rule {
		target_label = "instance"
		replacement  = "server"
	}
	forward_to = [prometheus.remote_write.cloud.receiver]
}

// ── 3. 백엔드 로그 ───────────────────────────────────────────────────────

// 백엔드가 /logs/backend.log에 쓰고(compose의 LOGGING_FILE_NAME) 수집기는 이 폴더만 읽기 전용으로 본다.
// Docker 로그 폴더(/var/lib/docker/containers)나 Docker 소켓은 쓰지 않는다. 거기에는 컨테이너
// 환경변수(DB 비밀번호, API 키)가 같이 들어 있어서 수집기가 읽을 수 있게 된다.
local.file_match "backend" {
	path_targets = [{
		__path__ = "/logs/backend.log",
		service  = "backend",
	}]
}

loki.source.file "backend" {
	targets = local.file_match.backend.targets
	// 처음 붙일 때 쌓여 있던 옛 로그를 한꺼번에 보내지 않는다. 이후에는 읽은 위치를 기억한다
	tail_from_end = true
	forward_to    = [loki.process.backend.receiver]
}

loki.process "backend" {
	// 예외 스택은 여러 줄이다. 시각으로 시작하는 줄을 새 로그의 첫 줄로 보고 나머지를 붙인다
	stage.multiline {
		firstline     = "^\\d{4}-\\d{2}-\\d{2}T"
		max_wait_time = "3s"
		max_lines     = 200
	}

	// "2026-11-25T01:27:41.083Z  WARN 1 --- ..." 에서 레벨을 뽑아 라벨로 단다 (ERROR만 골라 보기, 알림용)
	stage.regex {
		expression = "^\\S+\\s+(?P<level>TRACE|DEBUG|INFO|WARN|ERROR)\\s"
	}

	stage.labels {
		values = {
			level = "",
		}
	}

	forward_to = [loki.write.cloud.receiver]
}
